#!/usr/bin/env sh
bun -e 'const fs=require("fs");const file=process.argv[1];const o=fs.readFileSync(file,"utf8");const c=o.replace(/<think>[\s\S]*?<\/think>/g,"").replace(/^\s+|\s+$/g,"");if(c===""){console.error("husky - commit-msg: refusing empty commit message after stripping <think> blocks");process.exit(1)}if(c!==o){fs.writeFileSync(file,c+"\n");console.error("husky - commit-msg: stripped <think> block(s) from commit message")}' "$1"